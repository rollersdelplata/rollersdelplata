---
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/inicio';

const isActive = (path: string) => {
  if (path === '/inicio' && (currentPath === '' || currentPath === '/' || currentPath === '/inicio')) {
    return true;
  }
  return currentPath === path || currentPath.startsWith(path + '/');
};

const catalogoSublinks = [
  { label: 'Fotos cortinas Black out', href: '/catalogo/fotos-cortinas-black-out' },
  { label: 'Fotos cortinas Screen 5%', href: '/catalogo/fotos-cortinas-screen-5' },
  { label: 'Fotos cortinas Black out texturado', href: '/catalogo/fotos-cortinas-black-out-texturado' },
  { label: 'Fotos cortinas Traslúcidas', href: '/catalogo/fotos-cortinas-traslucidas' },
];

const accionamientosSublinks = [
  { label: 'Manual', href: '/accionamientos/manual' },
  { label: 'Motorizado', href: '/accionamientos/motorizado' },
];
---

<header class="sticky top-0 z-50 bg-white border-b border-slate-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo + Title -->
    <a href="/inicio" class="flex items-center gap-3 group">
      <img
        src="/images/logo.png"
        alt="Rollers del Plata"
        class="h-10 w-10 object-contain rounded-full"
      />
      <span class="font-heading text-xl tracking-normal text-[#212121] group-hover:opacity-80 transition">
        Rollers del Plata
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center space-x-1 h-full" aria-label="Navegación principal">
      <!-- Inicio -->
      <a
        href="/inicio"
        class:list={[
          'px-4 h-full flex items-center text-[15px] transition border-b-4',
          isActive('/inicio')
            ? 'border-[#b0bec5] text-[#212121] font-normal'
            : 'border-transparent text-[#212121]/80 hover:text-[#212121]',
        ]}
      >
        Inicio
      </a>

      <!-- Catalogo Dropdown -->
      <div class="relative group h-full flex items-center">
        <a
          href="/catalogo"
          class:list={[
            'px-4 h-full flex items-center gap-1.5 text-[15px] transition border-b-4',
            isActive('/catalogo')
              ? 'border-[#b0bec5] text-[#212121]'
              : 'border-transparent text-[#212121]/80 hover:text-[#212121]',
          ]}
        >
          <span>Catalogo</span>
          <svg class="w-4 h-4 text-[#212121]/70 group-hover:rotate-180 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </a>
        <div class="absolute left-0 top-full pt-0 w-64 bg-white shadow-lg border border-slate-200 rounded-b opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
          <div class="py-1">
            {catalogoSublinks.map((sub) => (
              <a
                href={sub.href}
                class:list={[
                  'block px-4 py-2.5 text-sm text-[#212121] hover:bg-[#eceff1] transition',
                  currentPath === sub.href ? 'bg-[#eceff1] font-semibold' : '',
                ]}
              >
                {sub.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Servicios -->
      <a
        href="/servicios"
        class:list={[
          'px-4 h-full flex items-center text-[15px] transition border-b-4',
          isActive('/servicios')
            ? 'border-[#b0bec5] text-[#212121]'
            : 'border-transparent text-[#212121]/80 hover:text-[#212121]',
        ]}
      >
        Servicios
      </a>

      <!-- Accionamientos Dropdown -->
      <div class="relative group h-full flex items-center">
        <a
          href="/accionamientos"
          class:list={[
            'px-4 h-full flex items-center gap-1.5 text-[15px] transition border-b-4',
            isActive('/accionamientos')
              ? 'border-[#b0bec5] text-[#212121]'
              : 'border-transparent text-[#212121]/80 hover:text-[#212121]',
          ]}
        >
          <span>Accionamientos</span>
          <svg class="w-4 h-4 text-[#212121]/70 group-hover:rotate-180 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </a>
        <div class="absolute left-0 top-full pt-0 w-48 bg-white shadow-lg border border-slate-200 rounded-b opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
          <div class="py-1">
            {accionamientosSublinks.map((sub) => (
              <a
                href={sub.href}
                class:list={[
                  'block px-4 py-2.5 text-sm text-[#212121] hover:bg-[#eceff1] transition',
                  currentPath === sub.href ? 'bg-[#eceff1] font-semibold' : '',
                ]}
              >
                {sub.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Clientes -->
      <a
        href="/clientes"
        class:list={[
          'px-4 h-full flex items-center text-[15px] transition border-b-4',
          isActive('/clientes')
            ? 'border-[#b0bec5] text-[#212121]'
            : 'border-transparent text-[#212121]/80 hover:text-[#212121]',
        ]}
      >
        Clientes
      </a>
    </nav>

    <!-- Mobile Menu Toggle -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="md:hidden p-2 rounded text-[#212121] hover:bg-[#eceff1] focus:outline-none"
      aria-label="Abrir menú de navegación"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-slate-200 px-4 pt-2 pb-4 space-y-1">
    <a href="/inicio" class="block py-2 px-3 rounded text-base font-medium text-[#212121] hover:bg-[#eceff1]">
      Inicio
    </a>
    <div>
      <a href="/catalogo" class="block py-2 px-3 rounded text-base font-medium text-[#212121] hover:bg-[#eceff1]">
        Catalogo
      </a>
      <div class="pl-6 space-y-1 border-l-2 border-[#b0bec5] ml-3">
        {catalogoSublinks.map((sub) => (
          <a href={sub.href} class="block py-1.5 px-3 text-sm text-[#212121]/80 hover:text-[#212121] hover:bg-[#eceff1] rounded">
            {sub.label}
          </a>
        ))}
      </div>
    </div>
    <a href="/servicios" class="block py-2 px-3 rounded text-base font-medium text-[#212121] hover:bg-[#eceff1]">
      Servicios
    </a>
    <div>
      <a href="/accionamientos" class="block py-2 px-3 rounded text-base font-medium text-[#212121] hover:bg-[#eceff1]">
        Accionamientos
      </a>
      <div class="pl-6 space-y-1 border-l-2 border-[#b0bec5] ml-3">
        {accionamientosSublinks.map((sub) => (
          <a href={sub.href} class="block py-1.5 px-3 text-sm text-[#212121]/80 hover:text-[#212121] hover:bg-[#eceff1] rounded">
            {sub.label}
          </a>
        ))}
      </div>
    </div>
    <a href="/clientes" class="block py-2 px-3 rounded text-base font-medium text-[#212121] hover:bg-[#eceff1]">
      Clientes
    </a>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
